{
  "name": "wa-chat-viewer",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Visor local de exportaciones de WhatsApp (TXT/ZIP) con fidelidad visual, PWA y procesamiento 100% en el navegador.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "icons": "node scripts/generate-icons.mjs",
    "samples": "node scripts/make-samples.mjs",
    "samples:big": "vite-node scripts/make-big-sample.mts",
    "bench:parser": "node --expose-gc node_modules/.bin/vite-node scripts/bench-parser.mts",
    "e2e:install": "playwright install chromium webkit firefox",
    "screenshots": "node scripts/screenshots.mjs",
    "verify": "npm run typecheck && npm test && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.14",
    "@zip.js/zip.js": "^2.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fake-indexeddb": "^6.2.5",
    "fflate": "^0.8.3",
    "jsdom": "^30.1.2",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-node": "^6.0.0",
    "vitest": "^5.0.3"
  },
  "license": "MIT"
}
